# Firebase - copy to .env and fill from Firebase Console
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# OpenRouter - server-side only. NEVER prefix this with VITE_:
# Vite inlines VITE_* vars into the public browser bundle, which would
# leak the key to anyone who views source. Read it only from a serverless
# function or a local Node script.
OPENROUTER_API_KEY=
