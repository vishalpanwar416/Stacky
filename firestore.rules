rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isOwnerOfWorkspace(workspaceId) {
      let path = /databases/$(database)/documents/workspaces/$(workspaceId);
      return isSignedIn() && exists(path) && get(path).data.get('ownerId', '') == request.auth.uid;
    }

    function isWorkspaceMember(workspaceId) {
      let path = /databases/$(database)/documents/workspaces/$(workspaceId);
      return isSignedIn() && exists(path) && (
        get(path).data.get('ownerId', '') == request.auth.uid
        || request.auth.uid in get(path).data.get('memberIds', [])
      );
    }

    // The member row is where a role lives. Absent or unset means 'member',
    // so existing rows keep working without a migration and a missing row can
    // never silently downgrade someone who is legitimately in memberIds.
    function memberRole(workspaceId) {
      let path = /databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid);
      return isSignedIn() && exists(path) ? get(path).data.get('role', 'member') : 'member';
    }

    // Read access. Roles do not gate reading — every member sees the workspace.
    function canRead(workspaceId) {
      return isWorkspaceMember(workspaceId);
    }

    // Write access. The owner always writes; everyone else must not be readonly.
    // This is the whole point of the role, so it is enforced here rather than in
    // the client, which can only ever be a convenience.
    function canWrite(workspaceId) {
      return isOwnerOfWorkspace(workspaceId)
        || (isWorkspaceMember(workspaceId) && memberRole(workspaceId) != 'readonly');
    }

    function isTaskAssignee(task) {
      let assignees = task.data.get('assignees', {});
      return assignees != null && (
        assignees.get('ownerId', '') == request.auth.uid
        || request.auth.uid in assignees.get('watcherIds', [])
      );
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);
    }

    match /workspaces/{workspaceId} {
      allow read: if isSignedIn() && (
        resource.data.get('ownerId', '') == request.auth.uid
        || request.auth.uid in resource.data.get('memberIds', [])
      );
      allow create: if isSignedIn() && request.resource.data.get('ownerId', '') == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.get('ownerId', '') == request.auth.uid;

      match /members/{memberId} {
        allow read: if isWorkspaceMember(workspaceId);
        // You may only ever create your own row, and only the workspace owner
        // may stamp it 'owner'. A readonly member cannot escape their role this
        // way: their row already exists, and update/delete are owner-only.
        allow create: if isSignedIn() && memberId == request.auth.uid && (
          isOwnerOfWorkspace(workspaceId)
          || request.resource.data.get('role', 'member') != 'owner'
        );
        allow update, delete: if isSignedIn() && isOwnerOfWorkspace(workspaceId);
      }
    }

    match /invitations/{invitationId} {
      allow read: if isSignedIn() && (
        request.auth.token.get('email', '').lower() == resource.data.invitedEmail
        || isOwnerOfWorkspace(resource.data.workspaceId)
      );
      allow create: if isSignedIn() && canWrite(request.resource.data.workspaceId);
      allow update: if isSignedIn() && (
        request.auth.token.get('email', '').lower() == resource.data.invitedEmail
        || isOwnerOfWorkspace(resource.data.workspaceId)
      );
      allow delete: if isSignedIn() && isOwnerOfWorkspace(resource.data.workspaceId);
    }

    match /notifications/{notificationId} {
      allow read, update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn(); // Allow app to create notifications for others
    }

    match /projects/{projectId} {
      allow read: if isSignedIn() && canRead(resource.data.workspaceId);
      allow create: if isSignedIn() && canWrite(request.resource.data.workspaceId);
      allow update, delete: if isSignedIn() && canWrite(resource.data.workspaceId);
    }

    match /tasks/{taskId} {
      allow read: if isSignedIn() && (
        isWorkspaceMember(resource.data.workspaceId)
        || isTaskAssignee(resource)
      );
      allow create: if isSignedIn() && canWrite(request.resource.data.workspaceId);
      // An assignee who is a readonly member stays readonly; the assignee clause
      // exists for people outside the workspace, not as a way around the role.
      allow update: if isSignedIn() && (
        canWrite(resource.data.workspaceId)
        || (isTaskAssignee(resource) && !isWorkspaceMember(resource.data.workspaceId))
      );
      allow delete: if isSignedIn() && canWrite(resource.data.workspaceId);
    }

    match /tasks/{taskId}/comments/{commentId} {
      allow read: if isSignedIn() && isWorkspaceMember(get(/databases/$(database)/documents/tasks/$(taskId)).data.workspaceId);
      allow create: if isSignedIn() && canWrite(get(/databases/$(database)/documents/tasks/$(taskId)).data.workspaceId);
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /tasks/{taskId}/activity/{activityId} {
      // Create must match read: without the membership check any signed-in user
      // could write fabricated history onto a task in a workspace they cannot
      // even read. The app only ever logs activity on tasks it can reach, so
      // this costs nothing; the MCP server uses the Admin SDK and is unaffected.
      allow read: if isSignedIn()
        && canRead(get(/databases/$(database)/documents/tasks/$(taskId)).data.workspaceId);
      allow create: if isSignedIn()
        && canWrite(get(/databases/$(database)/documents/tasks/$(taskId)).data.workspaceId);
      allow update, delete: if false;
    }

    // Unreferenced by the app and by the MCP server — nothing reads or writes
    // it. It was open to every signed-in user, so it is closed rather than left
    // as an unguarded collection nobody is watching. Give it a real rule if a
    // feature ever needs it.
    match /task_dependencies/{depId} {
      allow read, write: if false;
    }

    // MCP access tokens. Server-only, with no exceptions: these documents are
    // credentials, and the API (Admin SDK) is the only thing that should read
    // or write them. A client that could list this collection could enumerate
    // which users have tokens; one that could write it could mint its own.
    match /mcpTokens/{tokenId} {
      allow read, write: if false;
    }

    // The AI spend ledger. Server-only: a client that could write it could
    // reset the cap it exists to enforce.
    match /aiBudget/{day} {
      allow read, write: if false;
    }

    // Cached Overview read, one document per user (doc id == uid). It is keyed
    // by user rather than workspace because the default scope spans every
    // workspace they can reach, so no single workspace owns it.
    match /aiOverview/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Cached AI analysis, one document per workspace (doc id == workspaceId).
    // Holds no data the member can't already read — it is derived from their
    // own tasks — so workspace membership is the whole check.
    match /aiInsights/{workspaceId} {
      allow read, write: if isWorkspaceMember(workspaceId);
    }
  }
}
